{
  "name": "@bymax-one/nest-storage",
  "version": "1.0.3",
  "description": "Provider-agnostic S3-compatible object storage for NestJS. Works with AWS S3, DigitalOcean Spaces, Cloudflare R2, Backblaze B2, MinIO, Wasabi.",
  "author": "Bymax One <support@bymax.one>",
  "license": "MIT",
  "homepage": "https://github.com/bymaxone/nest-storage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymaxone/nest-storage.git"
  },
  "bugs": {
    "url": "https://github.com/bymaxone/nest-storage/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.mjs"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsup",
    "check:exports": "attw --pack . --profile strict",
    "check:published": "node scripts/check-published-surface.mjs",
    "check:runtime": "node scripts/check-consumer-runtime.mjs",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "mutation": "stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly",
    "mutation:incremental": "stryker run --incremental",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test:cov:all && pnpm build && pnpm size && pnpm check:published",
    "release": "npm publish --provenance --access public",
    "size": "node scripts/check-size.mjs",
    "test": "jest",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:cov": "jest --coverage",
    "test:cov:all": "jest --config jest.coverage.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.1.18",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "reflect-metadata": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": false
    },
    "@nestjs/core": {
      "optional": false
    },
    "@aws-sdk/client-s3": {
      "optional": false
    },
    "@aws-sdk/lib-storage": {
      "optional": false
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": false
    },
    "reflect-metadata": {
      "optional": false
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@aws-sdk/client-s3": "^3.1099.0",
    "@aws-sdk/lib-storage": "^3.1099.0",
    "@aws-sdk/s3-request-presigner": "^3.1099.0",
    "@eslint/js": "^9.39.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@stryker-mutator/core": "^9",
    "@stryker-mutator/jest-runner": "^9",
    "@stryker-mutator/typescript-checker": "^9",
    "@testcontainers/minio": "^12",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.8",
      "esbuild": "0.28.1",
      "fast-uri": "^3.1.4",
      "multer": "2.2.0",
      "protobufjs": "^7.6.5",
      "qs": "6.15.2",
      "undici": "^8.9.0",
      "uuid": "11.1.1"
    }
  },
  "keywords": [
    "nestjs",
    "storage",
    "s3",
    "aws-s3",
    "cloudflare-r2",
    "backblaze-b2",
    "digitalocean-spaces",
    "minio",
    "wasabi",
    "object-storage",
    "presigned-url",
    "multipart-upload"
  ],
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/server/index.cjs",
  "module": "./dist/server/index.mjs",
  "types": "./dist/server/index.d.cts",
  "typesVersions": {
    "*": {
      "shared": [
        "./dist/shared/index.d.cts"
      ]
    }
  }
}
